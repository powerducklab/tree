{
  "name": "@powerduck/tree",
  "version": "0.7.13",
  "description": "Extensible tree component for API navigation, schema exploration, and documentation. Supports OpenAPI 3.2 nested tags, x-tagGroups, and custom data sources.",
  "license": "MIT",
  "author": "powerduck",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./react/index.css": {
      "import": "./dist/react/index.css",
      "require": "./dist/react/index.css",
      "default": "./dist/react/index.css"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "ln -sf /Users/electron/powerduck-react/node_modules/react node_modules/react && ln -sf /Users/electron/powerduck-react/node_modules/react-dom node_modules/react-dom",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check",
    "check:english": "node scripts/check-english.mjs",
    "check": "npm run check:english && npm run typecheck && npm run typecheck:examples && npm test && npm run build",
    "preview": "vite --config examples/vite.config.ts",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json"
  },
  "peerDependencies": {
    "@chakra-ui/react": ">=3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@chakra-ui/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@powerduck/openapi-parser": "^0.3.5",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^24.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "^5.51.2",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "tree",
    "openapi",
    "api-navigation",
    "schema-explorer",
    "documentation",
    "chakra-ui",
    "powerduck"
  ],
  "publishConfig": {
    "access": "public"
  }
}
